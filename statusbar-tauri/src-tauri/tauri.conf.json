{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaude Bar",
  "version": "0.1.0",
  "identifier": "com.openclaude.statusbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "picker",
        "title": "OpenClaude Launch",
        "url": "index.html",
        "width": 460,
        "height": 300,
        "resizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "OpenClaude - Click to launch"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
